API_PORT=4000
APP_ORIGIN=http://localhost:3000
# With no DATABASE_URL, local development uses persistent embedded PostgreSQL.
PGLITE_DATA_DIR=../../.data/postgres
# DATABASE_URL=postgresql://codetogether:codetogether@localhost:5432/codetogether

# Media: host candidates only by default; remote-network calling needs TURN.
STUN_URLS=
TURN_URLS=
# Set only alongside TURN_URLS; keep the shared secret server-side.
# TURN_SHARED_SECRET=generate-a-secure-secret-in-your-provider-secret-store
# TURN_URLS=turn:turn.YOUR-DOMAIN:3478?transport=udp,turns:turn.YOUR-DOMAIN:5349?transport=tcp
TURN_TTL_SECONDS=600
ICE_TRANSPORT_POLICY=all

# Alternative: Metered temporary credentials (do not also set TURN_SHARED_SECRET).
# METERED_DOMAIN=your-app.metered.live
# METERED_SECRET_KEY=your-server-only-Developers-secret-not-a-credential-API-key
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turns:global.relay.metered.ca:443?transport=tcp
# Metered requires TURN_TTL_SECONDS >= 600. Allow at least two minutes warmup.
