{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "PGLITE_DATA_DIR",
        "APP_ORIGIN",
        "API_PORT",
        "API_HOST",
        "API_URL",
        "NEXT_PUBLIC_REALTIME_URL",
        "NODE_ENV",
        "DOTENV_CONFIG_PATH",
        "STUN_URLS",
        "TURN_URLS",
        "TURN_SHARED_SECRET",
        "TURN_TTL_SECONDS",
        "ICE_TRANSPORT_POLICY",
        "METERED_DOMAIN",
        "METERED_SECRET_KEY",
        "EXECUTION_ENABLED",
        "REDIS_URL",
        "EXECUTION_WORKER_TOKEN",
        "TRUSTED_PROXY_CIDRS"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["API_URL", "NEXT_PUBLIC_REALTIME_URL"]
    },
    "@codetogether/api#build": { "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
